{
  "name": "sadbhavna-api",
  "version": "0.1.0",
  "private": true,
  "description": "Sadbhavna tracking API. Money is bigint paise everywhere.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "migrate": "tsc -p tsconfig.build.json && node dist/db/migrate.js",
    "seed": "tsc -p tsconfig.build.json && node dist/db/seed.js",
    "seed:demo": "tsc -p tsconfig.build.json && node dist/db/seed-demo.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
