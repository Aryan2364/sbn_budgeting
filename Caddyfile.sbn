# Caddy site block for sbn.rgbindia.com.
#
# Append to /etc/caddy/Caddyfile — it follows the same shape as the
# v2e block already in that file — then:
#
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy issues the certificate itself on first request. No certbot.
#
# Ports follow the convention the rest of the file uses: frontend 3X00,
# backend 4X00. hcrm is 30xx, life/lbd 31xx+41xx, gbd-webinar 32xx,
# v2e 33xx+43xx, so sbn takes 3400 and 4400.

sbn.rgbindia.com {
	# Unlike v2e, this frontend does not rewrite /api itself — the
	# browser calls https://sbn.rgbindia.com/api directly, because
	# NEXT_PUBLIC_API_URL is baked into the bundle. So Caddy has to
	# route it.
	#
	# The prefix is NOT stripped: NestJS sets a global prefix of `api`
	# (backend/src/main.ts), so /api/auth/login is the real route.
	# `handle_path` or a `uri strip_prefix` here would 404 every call.
	@api path /api/*
	reverse_proxy @api localhost:4400

	reverse_proxy localhost:3400
}
