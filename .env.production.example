# Copy to .env.production ON THE SERVER and fill in. Never commit the real one.
#
# This single file is read twice: docker compose substitutes POSTGRES_* into
# the db service, and the backend/migrate/seed containers get the whole file
# as their environment.

# --- database -------------------------------------------------------------
POSTGRES_DB=sadbhavna
POSTGRES_USER=sadbhavna
POSTGRES_PASSWORD=change-me

# The host is the compose service name, not localhost — the API reaches the
# database over the compose network. Keep the credentials in step with the
# three values above.
DATABASE_URL=postgres://sadbhavna:change-me@db:5432/sadbhavna

# --- api ------------------------------------------------------------------
JWT_SECRET=change-me-before-anything-real
JWT_EXPIRES_IN=12h

# --- first admin ----------------------------------------------------------
# `docker compose run --rm seed` creates no account at all unless both of
# these are set, so there is never a guessable default account. Fill them in,
# run the seed once, then blank the password out of this file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
