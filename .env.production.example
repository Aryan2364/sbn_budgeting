# Copy to .env.production ON THE SERVER and fill in. Never commit the real one.
#
# The backend, migrate and seed containers all read this file.

# --- database (Amazon RDS) ------------------------------------------------
# RDS requires TLS, and src/db/pool.ts passes no ssl options of its own, so
# the mode and the CA path travel in the URL. The bundle is baked into the
# backend image at /app/certs/rds-global-bundle.pem by its Dockerfile.
#
# verify-full also checks the hostname, so DATABASE_URL must use the RDS
# endpoint exactly as AWS spells it — not an IP, not a CNAME of your own.
DATABASE_URL=postgres://USER:PASSWORD@database-1.cxoqkkq469da.ap-south-1.rds.amazonaws.com:5432/sadbhavna?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem

# --- api ------------------------------------------------------------------
JWT_SECRET=change-me-before-anything-real
JWT_EXPIRES_IN=12h

# --- first admin ----------------------------------------------------------
# `docker compose run --rm seed` creates no account at all unless both of
# these are set, so there is never a guessable default account. Fill them in,
# run the seed once, then blank the password out of this file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
